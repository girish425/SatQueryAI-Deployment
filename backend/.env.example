# Environment Configuration for SatQuery AI
# MongoDB Atlas Connection URI
# Never commit your real database password to version control
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?appName=SatQueryAI
DATABASE_NAME=satquery_ai

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Storage directories
UPLOAD_DIR=./uploads
EVIDENCE_DIR=./evidence
